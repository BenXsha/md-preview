[Desktop Entry]
Type=Application
Name=Markdown Preview (Browser)
Name[zh_CN]=Markdown 预览（浏览器）
Comment=Render Markdown with a Typora theme and open it in the web browser
Comment[zh_CN]=用 Typora 主题渲染 Markdown，并用浏览器打开
Exec=@BIN@ --html %f
Icon=text-markdown
Terminal=false
MimeType=text/markdown;text/x-markdown;
Categories=Qt;KDE;Graphics;Viewer;
InitialPreference=7
X-KDE-Keywords=Markdown,预览,Preview,Browser
